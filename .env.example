# Copy this file to .env.local and fill in your own values (Supabase > Connect).
# On Vercel, add the same two names under Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only (set in Vercel > Settings > Environment Variables, mark Sensitive. NEVER put in .env.local or commit):
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY    (lets the "Delete account" button work)
