{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/parts",
      "destination": "/api/seo"
    },
    {
      "source": "/parts/:vehicle",
      "destination": "/api/seo?vehicle=:vehicle"
    },
    {
      "source": "/parts/:vehicle/:part",
      "destination": "/api/seo?vehicle=:vehicle&part=:part"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/reminders.js": {
      "maxDuration": 60
    },
    "api/ask.js": {
      "maxDuration": 30
    }
  }
}
